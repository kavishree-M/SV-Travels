# Email-only booking backend: no database is used.
PORT=8080

# Gmail SMTP credentials. Use a Google App Password, not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password

# Inbox that receives booking enquiries. Defaults to MAIL_USERNAME if omitted.
SV_TRAVELS_EMAIL=your-gmail-address@gmail.com

# Frontend origins allowed to call the backend.
FRONTEND_URL=http://localhost:3000,http://localhost:5173
