# ========================================================
# SV Travels Frontend Environment Variables (.env.example)
# ========================================================

# Base URL pointing to deployed Spring Boot backend API
# Local dev: /api (proxied via Vite) or http://localhost:8080/api
# Production on Render: https://sv-travels-api.onrender.com/api
VITE_API_BASE_URL="/api"

# GEMINI_API_KEY: Injected by AI Studio if using Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current web application deployment URL
APP_URL="MY_APP_URL"
